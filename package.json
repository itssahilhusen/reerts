{
  "name": "reerts-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm run --filter @reerts/frontend --filter @reerts/backend --filter @reerts/orchestrator --parallel dev",
    "dev:all": "pnpm run --filter ./apps/* --parallel dev",
    "dev:frontend": "pnpm --filter @reerts/frontend run dev",
    "dev:backend": "pnpm --filter @reerts/backend run dev",
    "dev:orchestrator": "pnpm --filter @reerts/orchestrator run dev",
    "test:carousel": "pnpm --filter @reerts/backend run test:carousel",
    "test:worker": "pnpm --filter @reerts/backend run test:worker",
    "build": "pnpm db:generate && pnpm --filter @reerts/frontend run build",
    "build:all": "pnpm -r run build",
    "build:frontend": "pnpm --filter @reerts/frontend run build",
    "build:backend": "pnpm --filter @reerts/backend run build",
    "build:orchestrator": "pnpm --filter @reerts/orchestrator run build",
    "lint": "pnpm --filter @reerts/frontend run lint",
    "prisma-generate": "node -e \"try { require('child_process').execSync('prisma generate --schema=./libraries/database/prisma/schema.prisma', { stdio: 'inherit' }); } catch (e) { console.warn('Prisma generation notice:', e.message); }\"",
    "prisma-db-push": "prisma db push --schema=./libraries/database/prisma/schema.prisma",
    "prisma-studio": "prisma studio --schema=./libraries/database/prisma/schema.prisma",
    "db:generate": "pnpm run prisma-generate",
    "db:push": "pnpm run prisma-db-push",
    "db:studio": "pnpm run prisma-studio",
    "db:seed": "pnpm --filter @reerts/commands run seed",
    "docker:dev": "docker compose -f docker-compose.dev.yaml up -d",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "node -e \"try { require('child_process').execSync('prisma generate --schema=./libraries/database/prisma/schema.prisma', { stdio: 'inherit' }); } catch (e) { console.warn('Note: Prisma client locked by active dev process, generation will refresh on server restart.'); }\""
  },
  "dependencies": {
    "@auth/prisma-adapter": "^1.6.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@hookform/resolvers": "^3.6.0",
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.10.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^14.6.0",
    "geist": "^1.8.2",
    "ioredis": "^5.3.2",
    "lucide-react": "^0.400.0",
    "next": "14.2.5",
    "next-auth": "^4.24.7",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.52.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "postcss": "^8",
    "prisma": "^5.14.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
