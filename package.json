{
  "name": "reerts-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "libraries/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/frontend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:orchestrator": "npm run dev --workspace=apps/orchestrator",
    "build": "npm run db:generate && npm run build --workspace=apps/frontend",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "build:backend": "npm run build --workspace=apps/backend",
    "build:orchestrator": "npm run build --workspace=apps/orchestrator",
    "start": "npm run start --workspace=apps/frontend",
    "lint": "npm run lint --workspace=apps/frontend",
    "prisma-generate": "node -e \"try { require('child_process').execSync('npx prisma generate --schema=./libraries/database/prisma/schema.prisma', { stdio: 'inherit' }); } catch (e) { console.warn('Prisma generation notice:', e.message); }\"",
    "prisma-db-push": "npx prisma db push --schema=./libraries/database/prisma/schema.prisma",
    "prisma-studio": "npx prisma studio --schema=./libraries/database/prisma/schema.prisma",
    "db:generate": "npm run prisma-generate",
    "db:push": "npm run prisma-db-push",
    "db:studio": "npm run prisma-studio",
    "db:seed": "npm run seed --workspace=apps/commands",
    "postinstall": "node -e \"try { require('child_process').execSync('npx prisma generate --schema=./libraries/database/prisma/schema.prisma', { stdio: 'inherit' }); } catch (e) { console.warn('Note: Prisma client generation skipped or refreshed on server restart.'); }\""
  },
  "dependencies": {
    "@auth/prisma-adapter": "^1.6.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@hookform/resolvers": "^3.6.0",
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.10.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^11.2.10",
    "geist": "^1.3.1",
    "ioredis": "^5.3.2",
    "lucide-react": "^0.400.0",
    "next": "14.2.5",
    "next-auth": "^4.24.7",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.52.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "postcss": "^8",
    "prisma": "^5.14.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}