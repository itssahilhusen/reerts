ignore-workspace-root-check=true
node-linker=hoisted
restrict-manifest-changes=true
sync-injected-deps-after-scripts[]=build
inject-workspace-packages=true
only-built-dependencies=@prisma/client, @prisma/engines, esbuild, msgpackr-extract, prisma, unrs-resolver, bcrypt, bcryptjs, @scarf/scarf, puppeteer, @google/genai, protobufjs
